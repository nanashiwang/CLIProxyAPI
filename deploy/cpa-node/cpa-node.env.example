# Required node identity
CPA_NODE="cpa024"
CPA_DOMAIN="cpa024.meta-api.vip"

# Required secrets. Never commit the real file.
CPA_MANAGEMENT_KEY="replace-with-a-long-random-management-key"
CPA_API_KEYS="replace-api-key-1,replace-api-key-2"

# ACME account
ACME_EMAIL="nanashiwang@gmail.com"

# Existing sing-box configuration
SING_BOX_CONFIG="/etc/sing-box/config.json"

# Runtime defaults based on cpa024
CPA_PORT="8317"
CPA_LOG_LIMIT_MB="512"
CPA_ERROR_LOG_MAX_FILES="10"

# Optional management allowlist, for example "203.0.113.10/32". Empty means public.
CPA_ADMIN_CIDR=""

# Optional firewall management. Keep disabled until SSH access is verified.
ENABLE_UFW="0"
SSH_PORT="22"
